# Server only. Set these in Vercel (Production and Preview). Never prefix with VITE_.
# Supabase > Project Settings > API Keys > secret key (sb_secret_...). Never commit or share it.
SUPABASE_SERVICE_ROLE_KEY=
# 32+ random characters. `openssl rand -base64 48`
SESSION_SECRET=
# Optional overrides. The project URL and publishable key default to the values in server/app.ts.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
